  "checkpoint_config": "/net/storage/pr3/plgrid/plggdvps/rcorrente/dvps-fm/checkpoints/qwen_omni_four/config.json",
  "output_root": "/net/storage/pr3/plgrid/plggdvps/datasets/multimodal_training",
  "routes": {
